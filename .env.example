# Supabase Dashboard > Connect bölümünden alınır.
NEXT_PUBLIC_SUPABASE_URL=https://ieecxnccneypjmtmwgrj.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# İlk superadmin hesabının e-posta adresi.
SUPERADMIN_EMAIL=tolga@example.com

# Yönetim panelinde saklanan e-posta API anahtarını şifreler.
# En az 32 karakterlik rastgele ve yalnızca sunucuda tutulan bir değer kullanın.
SETTINGS_ENCRYPTION_KEY=CHANGE_TO_A_RANDOM_VALUE_WITH_AT_LEAST_32_CHARACTERS

# Yönetim panelindeki e-posta ayarları henüz girilmemişse kullanılacak yedek değerler.
RESEND_API_KEY=
EMAIL_FROM="Oceanman Edirne <randevu@example.com>"
EMAIL_REPLY_TO=
BUSINESS_NOTIFICATION_EMAIL=

# Yalnızca sunucuda tutulur. Google hizmet hesabının e-posta adresi ve özel anahtarı.
# Personel takvimleri bu e-posta adresiyle "Etkinliklerde değişiklik yapabilir" yetkisiyle paylaşılır.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

NEXT_PUBLIC_SITE_URL=https://oceanman.vercel.app
GOOGLE_WEBHOOK_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE
CALENDAR_ADMIN_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE
CRON_SECRET=CHANGE_TO_A_LONG_RANDOM_VALUE
